<script>
/* =========================================================
   STORAGE
========================================================= */

const STORAGE = {
  USERS:"common_space_users",
  BOOKINGS:"common_space_bookings",
  TABLES:"common_space_tables",
  POLICY:"common_space_policy",
  CURRENT_USER:"common_space_current_user",
  THEME:"common_space_theme"
};


/* =========================================================
   DEFAULT DATA
========================================================= */

const defaultTables = [
  {id:1,name:"Table 01",type:"Work Desk",maintenance:false},
  {id:2,name:"Table 02",type:"Work Desk",maintenance:false},
  {id:3,name:"Table 03",type:"Meeting",maintenance:false},
  {id:4,name:"Table 04",type:"Quiet Zone",maintenance:false},
  {id:5,name:"Table 05",type:"Work Desk",maintenance:false},
  {id:6,name:"Table 06",type:"Meeting",maintenance:false},
  {id:7,name:"Table 07",type:"Work Desk",maintenance:false},
  {id:8,name:"Table 08",type:"Quiet Zone",maintenance:false},
  {id:9,name:"Table 09",type:"Work Desk",maintenance:false},
  {id:10,name:"Table 10",type:"Meeting",maintenance:false},
  {id:11,name:"Table 11",type:"Work Desk",maintenance:false},
  {id:12,name:"Table 12",type:"Quiet Zone",maintenance:false}
];

const defaultPolicy = {
  open:"08:00",
  close:"20:00",
  maxHours:3
};


/* =========================================================
   INIT
========================================================= */

function initStorage(){

  if(!localStorage.getItem(STORAGE.USERS)){

    const admin = {
      id:crypto.randomUUID(),
      name:"System Administrator",
      email:"admin@demo.com",
      phone:"0800000000",
      password:"admin123",
      role:"admin"
    };

    localStorage.setItem(
      STORAGE.USERS,
      JSON.stringify([admin])
    );
  }

  if(!localStorage.getItem(STORAGE.TABLES)){

    localStorage.setItem(
      STORAGE.TABLES,
      JSON.stringify(defaultTables)
    );
  }

  if(!localStorage.getItem(STORAGE.BOOKINGS)){

    localStorage.setItem(
      STORAGE.BOOKINGS,
      JSON.stringify([])
    );
  }

  if(!localStorage.getItem(STORAGE.POLICY)){

    localStorage.setItem(
      STORAGE.POLICY,
      JSON.stringify(defaultPolicy)
    );
  }
}


function getUsers(){
  return JSON.parse(
    localStorage.getItem(STORAGE.USERS)||"[]"
  );
}

function saveUsers(data){
  localStorage.setItem(
    STORAGE.USERS,
    JSON.stringify(data)
  );
}

function getBookings(){
  return JSON.parse(
    localStorage.getItem(STORAGE.BOOKINGS)||"[]"
  );
}

function saveBookings(data){
  localStorage.setItem(
    STORAGE.BOOKINGS,
    JSON.stringify(data)
  );
}

function getTables(){
  return JSON.parse(
    localStorage.getItem(STORAGE.TABLES)||"[]"
  );
}

function saveTables(data){
  localStorage.setItem(
    STORAGE.TABLES,
    JSON.stringify(data)
  );
}

function getPolicy(){
  return JSON.parse(
    localStorage.getItem(STORAGE.POLICY) ||
    JSON.stringify(defaultPolicy)
  );
}

function savePolicyData(data){
  localStorage.setItem(
    STORAGE.POLICY,
    JSON.stringify(data)
  );
}

function getCurrentUser(){
  return JSON.parse(
    localStorage.getItem(STORAGE.CURRENT_USER) ||
    "null"
  );
}


/* =========================================================
   AUTH
========================================================= */

function switchAuth(mode){

  const loginForm =
    document.getElementById("loginForm");

  const registerForm =
    document.getElementById("registerForm");

  const loginTab =
    document.getElementById("loginTab");

  const registerTab =
    document.getElementById("registerTab");

  const title =
    document.getElementById("authTitle");

  clearAuthMessage();

  if(mode==="login"){

    loginForm.classList.remove("hidden");
    registerForm.classList.add("hidden");

    loginTab.classList.add("active");
    registerTab.classList.remove("active");

    title.textContent="เข้าสู่ระบบ";

  }else{

    loginForm.classList.add("hidden");
    registerForm.classList.remove("hidden");

    loginTab.classList.remove("active");
    registerTab.classList.add("active");

    title.textContent="สมัครสมาชิก";
  }
}


function showAuthMessage(message,type){

  const box =
    document.getElementById("authMessage");

  box.textContent=message;

  box.className=
    `auth-message show ${type}`;
}


function clearAuthMessage(){

  const box =
    document.getElementById("authMessage");

  box.textContent="";
  box.className="auth-message";
}


/* =========================================================
   REGISTER
========================================================= */

function register(event){

  event.preventDefault();

  const name =
    document.getElementById("registerName")
      .value.trim();

  const email =
    document.getElementById("registerEmail")
      .value.trim()
      .toLowerCase();

  const phone =
    document.getElementById("registerPhone")
      .value.trim();

  const password =
    document.getElementById("registerPassword")
      .value;

  const role =
    document.getElementById("registerRole")
      .value;

  const users=getUsers();

  if(
    users.some(user=>user.email===email)
  ){

    showAuthMessage(
      "Email นี้ถูกใช้งานแล้ว",
      "error"
    );

    return;
  }

  users.push({

    id:crypto.randomUUID(),

    name,
    email,
    phone,
    password,
    role
  });

  saveUsers(users);

  showAuthMessage(
    "สมัครสมาชิกสำเร็จ กรุณาเข้าสู่ระบบ",
    "success"
  );

  event.target.reset();

  setTimeout(()=>{
    switchAuth("login");

    document.getElementById("loginEmail")
      .value=email;

  },700);
}


/* =========================================================
   LOGIN
========================================================= */

function login(event){

  event.preventDefault();

  const email =
    document.getElementById("loginEmail")
      .value.trim()
      .toLowerCase();

  const password =
    document.getElementById("loginPassword")
      .value;

  const user =
    getUsers().find(
      u =>
        u.email===email &&
        u.password===password
    );

  if(!user){

    showAuthMessage(
      "Email หรือรหัสผ่านไม่ถูกต้อง",
      "error"
    );

    return;
  }

  localStorage.setItem(
    STORAGE.CURRENT_USER,
    JSON.stringify(user)
  );

  openApp(user);
}


function openApp(user){

  document
    .getElementById("authScreen")
    .classList.add("hidden");

  document
    .getElementById("appScreen")
    .classList.remove("hidden");

  document
    .getElementById("userBadge")
    .textContent =
      `${user.name} (${user.role.toUpperCase()})`;

  buildNavigation(user.role);

  processAutoRelease();

  if(user.role==="admin"){

    showPage("adminDashboard");

  }else{

    showPage("userHome");
  }
}


function logout(){

  localStorage.removeItem(
    STORAGE.CURRENT_USER
  );

  location.reload();
}


/* =========================================================
   NAVIGATION
========================================================= */

function buildNavigation(role){

  const nav =
    document.getElementById("navLinks");

  if(role==="user"){

    nav.innerHTML=`
      <button id="nav-userHome"
              onclick="showPage('userHome')">
        🪑 จองโต๊ะ
      </button>

      <button id="nav-myBookings"
              onclick="showPage('myBookings')">
        📋 การจองของฉัน
      </button>
    `;

  }else{

    nav.innerHTML=`
      <button id="nav-adminDashboard"
              onclick="showPage('adminDashboard')">
        📊 Dashboard
      </button>

      <button id="nav-adminManagement"
              onclick="showPage('adminManagement')">
        ⚙️ จัดการระบบ
      </button>
    `;
  }
}


function showPage(pageId){

  document
    .querySelectorAll(".page")
    .forEach(p=>p.classList.add("hidden"));

  const page =
    document.getElementById(pageId);

  if(!page)return;

  page.classList.remove("hidden");

  document
    .querySelectorAll(".nav-links button")
    .forEach(b=>b.classList.remove("active"));

  const navButton =
    document.getElementById(
      "nav-"+pageId
    );

  if(navButton)
    navButton.classList.add("active");

  if(pageId==="userHome"){

    setDefaultDate();
    renderFloorPlan();
  }

  if(pageId==="myBookings"){

    processAutoRelease();
    renderMyBookings();
  }

  if(pageId==="adminDashboard"){

    processAutoRelease();
    renderAdminDashboard();
  }

  if(pageId==="adminManagement"){

    renderAdminTables();
    renderPolicy();
    renderAdminBookings();
  }
}


/* =========================================================
   SEARCH
========================================================= */

let selectedTableId=null;


function setDefaultDate(){

  const input =
    document.getElementById("bookingDate");

  if(!input.value){

    input.value =
      new Date()
        .toISOString()
        .split("T")[0];
  }
}


function searchTables(){

  const date =
    document.getElementById("bookingDate").value;

  const start =
    document.getElementById("startTime").value;

  const end =
    document.getElementById("endTime").value;

  if(!date || !start || !end){

    showToast(
      "กรุณากรอกวันที่และเวลาให้ครบ",
      "error"
    );

    return;
  }

  if(start>=end){

    showToast(
      "เวลาเริ่มต้นต้องน้อยกว่าเวลาสิ้นสุด",
      "error"
    );

    return;
  }

  const policy=getPolicy();

  if(
    start<policy.open ||
    end>policy.close
  ){

    showToast(
      `ระบบเปิด ${policy.open} - ${policy.close}`,
      "error"
    );

    return;
  }

  const duration =
    timeToMinutes(end) -
    timeToMinutes(start);

  if(
    duration >
    Number(policy.maxHours)*60
  ){

    showToast(
      `จองได้สูงสุด ${policy.maxHours} ชั่วโมง`,
      "error"
    );

    return;
  }

  selectedTableId=null;

  renderFloorPlan();

  document.getElementById(
    "summaryContent"
  ).innerHTML=`
    <div>
      วันที่
      <strong>${formatDate(date)}</strong>
      <br>
      เวลา
      <strong>${start} - ${end}</strong>
    </div>
  `;
}


/* =========================================================
   FLOOR PLAN
========================================================= */

function renderFloorPlan(){

  const container =
    document.getElementById("floorPlan");

  if(!container)return;

  const date =
    document.getElementById("bookingDate").value;

  const start =
    document.getElementById("startTime").value;

  const end =
    document.getElementById("endTime").value;

  const type =
    document.getElementById("spaceType").value;

  container.innerHTML="";

  getTables().forEach(table=>{

    if(
      type!=="all" &&
      table.type!==type
    )return;

    const status =
      getTableStatus(
        table,
        date,
        start,
        end
      );

    const div =
      document.createElement("div");

    div.className=
      `table-seat ${status}`;

    if(
      Number(selectedTableId)===
      Number(table.id)
    ){
      div.classList.add("selected");
    }

    let text="ว่าง";

    if(status==="booked")
      text="มีคนจองแล้ว";

    if(status==="maintenance")
      text="ปิดปรับปรุง";

    div.innerHTML=`
      <div class="table-icon">
        ${status==="maintenance"?"🔧":"🪑"}
      </div>

      <div class="table-name">
        ${table.name}
      </div>

      <div class="table-type">
        ${table.type}
      </div>

      <div style="font-size:10px;margin-top:4px">
        ${text}
      </div>
    `;

    if(status==="available"){

      div.onclick=()=>{
        selectTable(table.id);
      };

    }else{

      div.onclick=()=>{

        showToast(
          status==="booked"
            ?"โต๊ะนี้ถูกจองแล้วในช่วงเวลานี้"
            :"โต๊ะนี้ปิดปรับปรุง",
          "error"
        );
      };
    }

    container.appendChild(div);
  });
}


function getTableStatus(
  table,
  date,
  start,
  end
){

  if(table.maintenance)
    return "maintenance";

  if(!date || !start || !end)
    return "available";

  const conflict =
    getBookings().some(booking=>{

      if(
        Number(booking.tableId)!==
        Number(table.id)
      )return false;

      if(booking.date!==date)
        return false;

      if(
        ![
          "pending",
          "approved",
          "checked-in"
        ].includes(booking.status)
      )return false;

      return isTimeOverlap(
        start,
        end,
        booking.startTime,
        booking.endTime
      );
    });

  return conflict?"booked":"available";
}


function selectTable(id){

  selectedTableId=id;

  renderFloorPlan();

  renderBookingSummary();
}


function renderBookingSummary(){

  const table =
    getTables().find(
      t =>
        Number(t.id)===
        Number(selectedTableId)
    );

  if(!table)return;

  const date =
    document.getElementById("bookingDate").value;

  const start =
    document.getElementById("startTime").value;

  const end =
    document.getElementById("endTime").value;

  document.getElementById(
    "summaryContent"
  ).innerHTML=`

    <div class="summary-row">
      <span>โต๊ะ</span>
      <strong>${table.name}</strong>
    </div>

    <div class="summary-row">
      <span>ประเภท</span>
      <strong>${table.type}</strong>
    </div>

    <div class="summary-row">
      <span>วันที่</span>
      <strong>${formatDate(date)}</strong>
    </div>

    <div class="summary-row">
      <span>เวลา</span>
      <strong>${start} - ${end}</strong>
    </div>

    <button class="btn btn-primary"
            style="width:100%;margin-top:18px"
            onclick="createBooking()">
      ✓ ยืนยันการจอง
    </button>
  `;
}


/* =========================================================
   BOOKING LOGIC
========================================================= */

function createBooking(){

  const user=getCurrentUser();

  if(!user)return;

  const date =
    document.getElementById("bookingDate").value;

  const start =
    document.getElementById("startTime").value;

  const end =
    document.getElementById("endTime").value;

  const table =
    getTables().find(
      t =>
        Number(t.id)===
        Number(selectedTableId)
    );

  if(!table){

    showToast(
      "กรุณาเลือกโต๊ะ",
      "error"
    );

    return;
  }

  if(table.maintenance){

    showToast(
      "โต๊ะนี้อยู่ในโหมด Maintenance",
      "error"
    );

    return;
  }

  const policy=getPolicy();

  const duration =
    timeToMinutes(end) -
    timeToMinutes(start);

  /* จำกัด 3 ชั่วโมง / วัน */

  if(
    duration >
    Number(policy.maxHours)*60
  ){

    showToast(
      `จองได้สูงสุด ${policy.maxHours} ชั่วโมง`,
      "error"
    );

    return;
  }

  /* ตรวจเวลาทำการ */

  if(
    start<policy.open ||
    end>policy.close
  ){

    showToast(
      `ระบบเปิด ${policy.open} - ${policy.close}`,
      "error"
    );

    return;
  }

  const bookings=getBookings();

  /* Time Conflict */

  const conflict =
    bookings.some(booking=>{

      if(
        Number(booking.tableId)!==
        Number(table.id)
      )return false;

      if(booking.date!==date)
        return false;

      if(
        ![
          "pending",
          "approved",
          "checked-in"
        ].includes(booking.status)
      )return false;

      return isTimeOverlap(
        start,
        end,
        booking.startTime,
        booking.endTime
      );
    });

  if(conflict){

    showToast(
      "เวลานี้มีการจองโต๊ะดังกล่าวแล้ว",
      "error"
    );

    renderFloorPlan();

    return;
  }

  /* จำกัดชั่วโมงรวมต่อวัน */

  const dailyMinutes =
    bookings
      .filter(booking=>
        booking.userId===user.id &&
        booking.date===date &&
        [
          "pending",
          "approved",
          "checked-in"
        ].includes(booking.status)
      )
      .reduce(
        (total,booking)=>
          total+
          timeToMinutes(booking.endTime)-
          timeToMinutes(booking.startTime),
        0
      );

  if(
    dailyMinutes+duration >
    Number(policy.maxHours)*60
  ){

    showToast(
      `คุณจองได้สูงสุด ${policy.maxHours} ชั่วโมงต่อวัน`,
      "error"
    );

    return;
  }

  const booking={

    id:crypto.randomUUID(),

    userId:user.id,

    userName:user.name,

    userEmail:user.email,

    tableId:table.id,

    tableName:table.name,

    tableType:table.type,

    date,

    startTime:start,

    endTime:end,

    status:"approved",

    checkedInAt:null,

    createdAt:new Date().toISOString()
  };

  bookings.push(booking);

  saveBookings(bookings);

  showToast(
    "จองโต๊ะสำเร็จ",
    "success"
  );

  selectedTableId=null;

  renderFloorPlan();

  document.getElementById(
    "summaryContent"
  ).innerHTML=`
    <div style="
      text-align:center;
      color:var(--green);
      padding:20px;
    ">
      ✓ บันทึกการจองเรียบร้อยแล้ว
    </div>
  `;

  setTimeout(()=>{
    showPage("myBookings");
  },600);
}


/* =========================================================
   MY BOOKINGS
========================================================= */

function renderMyBookings(){

  const user=getCurrentUser();

  const container =
    document.getElementById("myBookingList");

  if(!container || !user)return;

  const bookings =
    getBookings()
      .filter(
        b=>b.userId===user.id
      )
      .sort(
        (a,b)=>
          new Date(`${b.date}T${b.startTime}`)-
          new Date(`${a.date}T${a.startTime}`)
      );

  container.innerHTML="";

  if(!bookings.length){

    container.innerHTML=`
      <div class="card"
           style="padding:40px;text-align:center;color:var(--muted)">
        ยังไม่มีประวัติการจอง
      </div>
    `;

    return;
  }

  bookings.forEach(booking=>{

    const card =
      document.createElement("div");

    card.className=
      "card booking-card";

    const status =
      getStatusLabel(booking.status);

    const start =
      new Date(
        `${booking.date}T${booking.startTime}`
      );

    const end =
      new Date(
        `${booking.date}T${booking.endTime}`
      );

    const now=new Date();

    let actions="";

    /* Cancel */

    if(
      booking.status==="approved" &&
      now<start
    ){

      actions+=`
        <button class="btn btn-danger btn-sm"
                onclick="cancelBooking('${booking.id}')">
          ยกเลิกการจอง
        </button>
      `;
    }

    /* Check-in */

    if(
      booking.status==="approved" &&
      now>=start &&
      now<=end
    ){

      actions+=`
        <button class="btn btn-success btn-sm"
                onclick="checkIn('${booking.id}')">
          ✓ เช็กอินเข้าใช้งาน
        </button>
      `;
    }

    card.innerHTML=`

      <div>

        <h3>
          ${booking.tableName}
        </h3>

        <div class="booking-meta">

          <span>
            📅 ${formatDate(booking.date)}
          </span>

          <span>
            ⏰ ${booking.startTime} - ${booking.endTime}
          </span>

          <span>
            📍 ${booking.tableType}
          </span>

        </div>

        <span class="status ${status.class}">
          ${status.text}
        </span>

      </div>

      <div class="booking-actions">
        ${actions}
      </div>
    `;

    container.appendChild(card);
  });
}


function cancelBooking(id){

  const bookings=getBookings();

  const booking =
    bookings.find(
      b=>b.id===id
    );

  if(!booking)return;

  const start =
    new Date(
      `${booking.date}T${booking.startTime}`
    );

  if(new Date()>=start){

    showToast(
      "ไม่สามารถยกเลิกหลังเริ่มใช้งานได้",
      "error"
    );

    return;
  }

  booking.status="cancelled";

  saveBookings(bookings);

  showToast(
    "ยกเลิกการจองแล้ว",
    "success"
  );

  renderMyBookings();
}


function checkIn(id){

  const bookings=getBookings();

  const booking =
    bookings.find(
      b=>b.id===id
    );

  if(!booking)return;

  const now=new Date();

  const start =
    new Date(
      `${booking.date}T${booking.startTime}`
    );

  const end =
    new Date(
      `${booking.date}T${booking.endTime}`
    );

  const release =
    new Date(
      start.getTime()+15*60*1000
    );

  if(now<start){

    showToast(
      "ยังไม่ถึงเวลาเริ่มใช้งาน",
      "error"
    );

    return;
  }

  if(now>release){

    booking.status="no-show";

    saveBookings(bookings);

    showToast(
      "เลยเวลา Check-in 15 นาที ระบบคืนโต๊ะแล้ว",
      "error"
    );

    renderMyBookings();
    renderFloorPlan();

    return;
  }

  if(now>end){

    showToast(
      "หมดเวลาใช้งานแล้ว",
      "error"
    );

    return;
  }

  booking.status="checked-in";

  booking.checkedInAt =
    now.toISOString();

  saveBookings(bookings);

  showToast(
    "Check-in สำเร็จ",
    "success"
  );

  renderMyBookings();
}


/* =========================================================
   AUTO RELEASE
========================================================= */

function processAutoRelease(){

  const bookings=getBookings();

  const now=new Date();

  let changed=false;

  bookings.forEach(booking=>{

    if(
      booking.status!=="approved"
    )return;

    const start =
      new Date(
        `${booking.date}T${booking.startTime}`
      );

    const release =
      new Date(
        start.getTime()+15*60*1000
      );

    if(now>release){

      booking.status="no-show";

      changed=true;
    }
  });

  if(changed)
    saveBookings(bookings);
}


/* =========================================================
   ADMIN DASHBOARD
========================================================= */

let pieChart=null;
let barChart=null;


function renderAdminDashboard(){

  const today =
    new Date()
      .toISOString()
      .split("T")[0];

  const bookings=getBookings();

  const todayBookings =
    bookings.filter(
      b=>b.date===today
    );

  document.getElementById(
    "kpiBookings"
  ).textContent=
    todayBookings.length;

  const now=new Date();

  const active =
    todayBookings.filter(b=>{

      if(b.status!=="checked-in")
        return false;

      const start =
        new Date(
          `${b.date}T${b.startTime}`
        );

      const end =
        new Date(
          `${b.date}T${b.endTime}`
        );

      return now>=start && now<=end;
    });

  document.getElementById(
    "kpiActive"
  ).textContent=
    active.length;

  document.getElementById(
    "kpiNoShow"
  ).textContent=
    todayBookings.filter(
      b=>b.status==="no-show"
    ).length;

  renderCharts(todayBookings);
}


function renderCharts(bookings){

  const typeCount={
    "Work Desk":0,
    "Meeting":0,
    "Quiet Zone":0
  };

  bookings.forEach(b=>{

    if(
      typeCount[b.tableType]!==undefined
    ){

      typeCount[b.tableType]++;
    }
  });

  if(pieChart)
    pieChart.destroy();

  pieChart =
    new Chart(
      document.getElementById("pieChart"),
      {
        type:"pie",

        data:{
          labels:Object.keys(typeCount),

          datasets:[{
            data:Object.values(typeCount),

            backgroundColor:[
              "#f97316",
              "#fb923c",
              "#fdba74"
            ],

            borderWidth:0
          }]
        },

        options:{
          responsive:true,
          maintainAspectRatio:false,

          plugins:{
            legend:{
              position:"bottom"
            }
          }
        }
      }
    );


  const slots=[
    "08-10",
    "10-12",
    "12-14",
    "14-16",
    "16-18",
    "18-20"
  ];

  const counts=
    slots.map(()=>0);

  bookings.forEach(b=>{

    const start=
      timeToMinutes(b.startTime);

    const index=
      Math.floor(
        (start-8*60)/120
      );

    if(
      index>=0 &&
      index<counts.length
    ){

      counts[index]++;
    }
  });

  if(barChart)
    barChart.destroy();

  barChart =
    new Chart(
      document.getElementById("barChart"),
      {
        type:"bar",

        data:{
          labels:slots,

          datasets:[{
            label:"จำนวนการใช้งาน",

            data:counts,

            backgroundColor:"#f97316",

            borderRadius:7
          }]
        },

        options:{
          responsive:true,
          maintainAspectRatio:false,

          scales:{
            y:{
              beginAtZero:true,
              ticks:{
                precision:0
              }
            }
          },

          plugins:{
            legend:{
              display:false
            }
          }
        }
      }
    );
}


