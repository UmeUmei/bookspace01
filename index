function saveTable(event){

  event.preventDefault();

  const id =
    document.getElementById(
      "editTableId"
    ).value;

  const name =
    document.getElementById(
      "tableName"
    ).value.trim();

  const type =
    document.getElementById(
      "tableType"
    ).value;

  const tables=getTables();

  if(id){

    const table =
      tables.find(
        t=>Number(t.id)===Number(id)
      );

    if(table){

      table.name=name;
      table.type=type;
    }

    showToast(
      "แก้ไขโต๊ะสำเร็จ",
      "success"
    );

  }else{

    tables.push({
      id:Date.now(),
      name,
      type,
      maintenance:false
    });

    showToast(
      "เพิ่มโต๊ะสำเร็จ",
      "success"
    );
  }

  saveTables(tables);

  resetTableForm();

  renderAdminTables();
}


function editTable(id){

  const table =
    getTables().find(
      t=>Number(t.id)===Number(id)
    );

  if(!table)return;

  document.getElementById(
    "editTableId"
  ).value=table.id;

  document.getElementById(
    "tableName"
  ).value=table.name;

  document.getElementById(
    "tableType"
  ).value=table.type;

  document.getElementById(
    "tableFormTitle"
  ).textContent="แก้ไขข้อมูลโต๊ะ";
}


function resetTableForm(){

  document.getElementById(
    "editTableId"
  ).value="";

  document.getElementById(
    "tableName"
  ).value="";

  document.getElementById(
    "tableType"
  ).value="Work Desk";

  document.getElementById(
    "tableFormTitle"
  ).textContent="เพิ่มโต๊ะ";
}


function deleteTable(id){

  const hasBooking =
    getBookings().some(
      b=>
        Number(b.tableId)===Number(id) &&
        [
          "pending",
          "approved",
          "checked-in"
        ].includes(b.status)
    );

  if(hasBooking){

    showToast(
      "ไม่สามารถลบโต๊ะที่มีการจองอยู่ได้",
      "error"
    );

    return;
  }

  if(!confirm("ต้องการลบโต๊ะนี้หรือไม่?"))
    return;

  saveTables(
    getTables().filter(
      t=>Number(t.id)!==Number(id)
    )
  );

  renderAdminTables();

  showToast(
    "ลบโต๊ะแล้ว",
    "success"
  );
}


function toggleMaintenance(id){

  const tables=getTables();

  const table =
    tables.find(
      t=>Number(t.id)===Number(id)
    );

  if(!table)return;

  table.maintenance=
    !table.maintenance;

  saveTables(tables);

  renderAdminTables();

  showToast(
    table.maintenance
      ?"เปิด Maintenance Mode แล้ว"
      :"เปิดใช้งานโต๊ะแล้ว",
    "success"
  );
}


