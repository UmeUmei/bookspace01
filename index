<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ระบบจองโต๊ะและพื้นที่ส่วนกลาง</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
:root{
  --primary:#f97316;
  --primary-dark:#ea580c;
  --primary-light:#fff7ed;
  --bg:#f8fafc;
  --card:#ffffff;
  --text:#1e293b;
  --muted:#64748b;
  --border:#e2e8f0;

  --green:#16a34a;
  --green-bg:#dcfce7;

  --red:#dc2626;
  --red-bg:#fee2e2;

  --gray:#64748b;
  --gray-bg:#e2e8f0;

  --yellow:#d97706;
  --yellow-bg:#fef3c7;

  --blue:#2563eb;
  --blue-bg:#dbeafe;

  --shadow:0 10px 30px rgba(15,23,42,.08);
}

body.dark{
  --bg:#0f172a;
  --card:#1e293b;
  --text:#f8fafc;
  --muted:#94a3b8;
  --border:#334155;
  --primary-light:#431407;
  --green-bg:#14532d;
  --red-bg:#450a0a;
  --gray-bg:#334155;
  --yellow-bg:#451a03;
  --blue-bg:#172554;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:"Kanit",sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  transition:.2s;
}

button,input,select{
  font-family:inherit;
}

button{
  cursor:pointer;
}

.hidden{
  display:none!important;
}

.container{
  width:min(1200px,94%);
  margin:auto;
}

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:18px;
  box-shadow:var(--shadow);
}

.btn{
  border:0;
  border-radius:10px;
  padding:10px 16px;
  font-size:14px;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-1px);
}

.btn-primary{
  background:var(--primary);
  color:#fff;
}

.btn-primary:hover{
  background:var(--primary-dark);
}

.btn-success{
  background:var(--green);
  color:#fff;
}

.btn-danger{
  background:var(--red);
  color:#fff;
}

.btn-warning{
  background:var(--yellow);
  color:#fff;
}

.btn-secondary{
  background:var(--gray-bg);
  color:var(--text);
}

.btn-outline{
  background:transparent;
  color:var(--text);
  border:1px solid var(--border);
}

.btn-sm{
  padding:7px 11px;
  font-size:12px;
}

input,select{
  width:100%;
  padding:11px 13px;
  border:1px solid var(--border);
  border-radius:10px;
  outline:none;
  background:var(--card);
  color:var(--text);
}

input:focus,select:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px rgba(249,115,22,.12);
}

.form-group{
  margin-bottom:15px;
}

.form-group label{
  display:block;
  margin-bottom:6px;
  font-size:13px;
}

/* =========================
   AUTH
========================= */

#authScreen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:
    radial-gradient(circle at top right,#fed7aa,transparent 35%),
    var(--bg);
}

.auth-wrapper{
  width:min(950px,100%);
  display:grid;
  grid-template-columns:1fr 1fr;
  overflow:hidden;
  background:var(--card);
  border-radius:25px;
  box-shadow:0 25px 60px rgba(0,0,0,.13);
}

.auth-brand{
  padding:50px;
  color:#fff;
  background:linear-gradient(145deg,#fb923c,#ea580c);
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.auth-brand .logo{
  font-size:50px;
  margin-bottom:15px;
}

.auth-brand h1{
  font-size:32px;
  line-height:1.3;
  margin-bottom:15px;
}

.auth-brand p{
  line-height:1.8;
  opacity:.9;
}

.auth-box{
  padding:45px;
}

.auth-box h2{
  font-size:28px;
  margin-bottom:5px;
}

.auth-subtitle{
  color:var(--muted);
  font-size:13px;
  margin-bottom:25px;
}

.auth-tabs{
  display:flex;
  gap:5px;
  padding:4px;
  background:var(--gray-bg);
  border-radius:10px;
  margin-bottom:22px;
}

.auth-tabs button{
  flex:1;
  border:0;
  background:transparent;
  color:var(--text);
  padding:9px;
  border-radius:8px;
}

.auth-tabs button.active{
  background:var(--card);
  color:var(--primary);
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.auth-message{
  display:none;
  padding:10px;
  margin-bottom:15px;
  border-radius:8px;
  font-size:13px;
}

.auth-message.show{
  display:block;
}

.auth-message.error{
  color:var(--red);
  background:var(--red-bg);
}

.auth-message.success{
  color:var(--green);
  background:var(--green-bg);
}

/* =========================
   NAVBAR
========================= */

.navbar{
  position:sticky;
  top:0;
  z-index:100;
  background:var(--card);
  border-bottom:1px solid var(--border);
}

.nav-inner{
  min-height:68px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.logo-text{
  color:var(--primary);
  font-weight:600;
  white-space:nowrap;
}

.nav-links{
  display:flex;
  gap:5px;
}

.nav-links button{
  border:0;
  background:transparent;
  color:var(--text);
  padding:9px 12px;
  border-radius:8px;
}

.nav-links button:hover,
.nav-links button.active{
  background:var(--primary-light);
  color:var(--primary);
}

.nav-actions{
  display:flex;
  align-items:center;
  gap:7px;
}

.user-badge{
  color:var(--primary);
  background:var(--primary-light);
  padding:7px 11px;
  border-radius:20px;
  font-size:12px;
}

/* =========================
   MAIN
========================= */

main{
  padding:35px 0 60px;
}

.section-title{
  margin-bottom:20px;
}

.section-title h2{
  font-size:26px;
}

.section-title p{
  color:var(--muted);
  font-size:13px;
}

/* =========================
   SEARCH
========================= */

.search-card{
  padding:20px;
  margin-bottom:22px;
}

.search-grid{
  display:grid;
  grid-template-columns:1.2fr 1fr 1fr 1.3fr auto;
  gap:12px;
  align-items:end;
}

/* =========================
   FLOOR PLAN
========================= */

.floor-layout{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:20px;
}

.floor-card{
  padding:22px;
}

.floor-plan{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-top:20px;
}

.table-seat{
  min-height:125px;
  border-radius:15px;
  padding:12px;
  border:3px solid transparent;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  transition:.2s;
}

.table-seat.available{
  background:var(--green-bg);
  color:var(--green);
  border-color:#86efac;
}

.table-seat.booked{
  background:var(--red-bg);
  color:var(--red);
  border-color:#fca5a5;
  cursor:not-allowed;
}

.table-seat.maintenance{
  background:var(--gray-bg);
  color:var(--gray);
  border-color:var(--border);
  cursor:not-allowed;
}

.table-seat.selected{
  border-color:var(--primary);
  box-shadow:0 0 0 4px rgba(249,115,22,.15);
  transform:translateY(-2px);
}

.table-icon{
  font-size:28px;
}

.table-name{
  font-weight:600;
}

.table-type{
  font-size:11px;
  opacity:.8;
}

.legend{
  display:flex;
  flex-wrap:wrap;
  gap:15px;
  margin-top:20px;
  color:var(--muted);
  font-size:12px;
}

.legend-item{
  display:flex;
  align-items:center;
  gap:5px;
}

.legend-color{
  width:14px;
  height:14px;
  border-radius:4px;
}

.booking-summary{
  padding:22px;
  height:max-content;
}

.summary-row{
  display:flex;
  justify-content:space-between;
  gap:10px;
  padding:10px 0;
  border-bottom:1px solid var(--border);
  font-size:13px;
}

.summary-row span{
  color:var(--muted);
}

.summary-empty{
  color:var(--muted);
  text-align:center;
  padding:30px 5px;
  font-size:13px;
}

/* =========================
   BOOKINGS
========================= */

.booking-list{
  display:grid;
  gap:15px;
}

.booking-card{
  padding:20px;
  display:grid;
  grid-template-columns:1fr auto;
  gap:15px;
  align-items:center;
}

.booking-card h3{
  margin-bottom:5px;
}

.booking-meta{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  color:var(--muted);
  font-size:12px;
  margin-bottom:8px;
}

.booking-actions{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
}

.status{
  display:inline-block;
  border-radius:20px;
  padding:4px 9px;
  font-size:11px;
}

.status-approved{
  color:var(--green);
  background:var(--green-bg);
}

.status-pending{
  color:var(--yellow);
  background:var(--yellow-bg);
}

.status-cancelled,
.status-rejected,
.status-noshow{
  color:var(--red);
  background:var(--red-bg);
}

.status-checked{
  color:var(--blue);
  background:var(--blue-bg);
}

/* =========================
   ADMIN DASHBOARD
========================= */

.kpi-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
  margin-bottom:20px;
}

.kpi{
  padding:22px;
}

.kpi-icon{
  width:44px;
  height:44px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:12px;
  background:var(--primary-light);
  color:var(--primary);
  font-size:20px;
  margin-bottom:12px;
}

.kpi h3{
  font-size:30px;
}

.kpi p{
  color:var(--muted);
  font-size:12px;
}

.charts-grid{
  display:grid;
  grid-template-columns:1fr 1.5fr;
  gap:20px;
}

.chart-card{
  padding:22px;
  min-height:350px;
}

.chart-card h3{
  margin-bottom:15px;
}

.chart-wrapper{
  position:relative;
  height:270px;
}

/* =========================
   ADMIN MANAGEMENT
========================= */

.admin-section{
  padding:22px;
  margin-bottom:20px;
}

.admin-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:18px;
}

.management-grid{
  display:grid;
  grid-template-columns:1fr 2fr;
  gap:20px;
}

.form-card{
  padding:20px;
}

.admin-table-list{
  display:grid;
  gap:10px;
}

.admin-table-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  border:1px solid var(--border);
  border-radius:12px;
  padding:14px;
}

.table-actions{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
}

/* =========================
   DATA TABLE
========================= */

.table-wrapper{
  overflow-x:auto;
}

.data-table{
  width:100%;
  border-collapse:collapse;
  min-width:800px;
}

.data-table th,
.data-table td{
  padding:11px;
  border-bottom:1px solid var(--border);
  text-align:left;
  font-size:12px;
}

.data-table th{
  background:var(--primary-light);
  color:var(--muted);
}

/* =========================
   TOAST
========================= */

#toastContainer{
  position:fixed;
  right:20px;
  bottom:20px;
  z-index:9999;
  display:grid;
  gap:8px;
}

.toast{
  min-width:250px;
  max-width:350px;
  padding:13px 15px;
  border-radius:10px;
  background:var(--card);
  border:1px solid var(--border);
  box-shadow:var(--shadow);
  font-size:13px;
  animation:toastIn .25s ease;
}

.toast.success{
  border-left:4px solid var(--green);
}

.toast.error{
  border-left:4px solid var(--red);
}

@keyframes toastIn{
  from{
    opacity:0;
    transform:translateY(15px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* =========================
   TABLET
========================= */

@media(max-width:992px){

  .nav-inner{
    flex-wrap:wrap;
    padding:9px 0;
  }

  .nav-links{
    width:100%;
    order:3;
    overflow-x:auto;
  }

  .search-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .floor-layout,
  .charts-grid,
  .management-grid{
    grid-template-columns:1fr;
  }

  .floor-plan{
    grid-template-columns:repeat(3,1fr);
  }

  .kpi-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

/* =========================
   MOBILE
========================= */

@media(max-width:576px){

  .container{
    width:94%;
  }

  main{
    padding-top:22px;
  }

  .auth-wrapper{
    grid-template-columns:1fr;
  }

  .auth-brand{
    display:none;
  }

  .auth-box{
    padding:30px 22px;
  }

  .search-grid{
    grid-template-columns:1fr;
  }

  .floor-plan{
    grid-template-columns:repeat(2,1fr);
    gap:10px;
  }

  .table-seat{
    min-height:105px;
  }

  .kpi-grid{
    grid-template-columns:1fr;
  }

  .booking-card{
    grid-template-columns:1fr;
  }

  .user-badge{
    display:none;
  }

  .logo-text{
    font-size:15px;
  }

  .section-title h2{
    font-size:22px;
  }

  .admin-header{
    align-items:flex-start;
    flex-direction:column;
  }

  .admin-table-item{
    align-items:flex-start;
    flex-direction:column;
  }
}
</style>
</head>

<body>

<!-- =========================================================
     AUTH SCREEN
========================================================= -->

<section id="authScreen">

  <div class="auth-wrapper">

    <div class="auth-brand">
      <div class="logo">🪑</div>

      <h1>
        ระบบจองโต๊ะ<br>
        และพื้นที่ส่วนกลาง
      </h1>

      <p>
        ระบบจองพื้นที่ส่วนกลางสำหรับนักศึกษา
        พนักงาน และผู้ดูแลระบบ
        พร้อมระบบจัดการการจองแบบครบวงจร
      </p>
    </div>

    <div class="auth-box">

      <h2 id="authTitle">เข้าสู่ระบบ</h2>

      <div class="auth-subtitle">
        Common Space Reservation System
      </div>

      <div class="auth-tabs">
        <button id="loginTab"
                class="active"
                onclick="switchAuth('login')">
          เข้าสู่ระบบ
        </button>

        <button id="registerTab"
                onclick="switchAuth('register')">
          สมัครสมาชิก
        </button>
      </div>

      <div id="authMessage"
           class="auth-message"></div>

      <!-- LOGIN -->

      <form id="loginForm"
            onsubmit="login(event)">

        <div class="form-group">
          <label>Email</label>

          <input id="loginEmail"
                 type="email"
                 placeholder="example@email.com"
                 required>
        </div>

        <div class="form-group">
          <label>รหัสผ่าน</label>

          <input id="loginPassword"
                 type="password"
                 placeholder="••••••••"
                 required>
        </div>

        <button class="btn btn-primary"
                style="width:100%"
                type="submit">
          เข้าสู่ระบบ
        </button>

        <p style="
          color:var(--muted);
          font-size:11px;
          text-align:center;
          margin-top:15px;
        ">
          Demo Admin:
          admin@demo.com / admin123
        </p>

      </form>

      <!-- REGISTER -->

      <form id="registerForm"
            class="hidden"
            onsubmit="register(event)">

        <div class="form-group">
          <label>ชื่อ-นามสกุล</label>

          <input id="registerName"
                 placeholder="ชื่อ นามสกุล"
                 required>
        </div>

        <div class="form-group">
          <label>Email</label>

          <input id="registerEmail"
                 type="email"
                 placeholder="example@email.com"
                 required>
        </div>

        <div class="form-group">
          <label>เบอร์โทรศัพท์</label>

          <input id="registerPhone"
                 type="tel"
                 placeholder="08xxxxxxxx"
                 required>
        </div>

        <div class="form-group">
          <label>Role</label>

          <select id="registerRole">
            <option value="user">
              User - นักศึกษา/พนักงาน
            </option>

            <option value="admin">
              Admin - ผู้ดูแลระบบ
            </option>
          </select>
        </div>

        <div class="form-group">
          <label>รหัสผ่าน</label>

          <input id="registerPassword"
                 type="password"
                 minlength="6"
                 placeholder="อย่างน้อย 6 ตัวอักษร"
                 required>
        </div>

        <button class="btn btn-primary"
                style="width:100%"
                type="submit">
          สมัครสมาชิก
        </button>

      </form>

    </div>
  </div>
</section>


<!-- =========================================================
     APP
========================================================= -->

<section id="appScreen" class="hidden">

<nav class="navbar">

  <div class="container nav-inner">

    <div class="logo-text">
      🪑 Common Space
    </div>

    <div id="navLinks"
         class="nav-links"></div>

    <div class="nav-actions">

      <span id="userBadge"
            class="user-badge"></span>

      <button class="btn btn-outline btn-sm"
              onclick="toggleTheme()">
        🌓
      </button>

      <button class="btn btn-outline btn-sm"
              onclick="logout()">
        ออกจากระบบ
      </button>

    </div>

  </div>

</nav>


<main>

<div class="container">

<!-- =========================================================
     USER HOME
========================================================= -->

<section id="userHome"
         class="page hidden">

  <div class="section-title">

    <h2>🪑 จองโต๊ะและพื้นที่</h2>

    <p>
      เลือกวันที่ เวลา และประเภทพื้นที่
      จากนั้นเลือกโต๊ะที่ต้องการ
    </p>

  </div>


  <div class="card search-card">

    <div class="search-grid">

      <div class="form-group">
        <label>วันที่</label>

        <input id="bookingDate"
               type="date">
      </div>

      <div class="form-group">
        <label>เวลาเริ่มต้น</label>

        <input id="startTime"
               type="time"
               value="09:00">
      </div>

      <div class="form-group">
        <label>เวลาสิ้นสุด</label>

        <input id="endTime"
               type="time"
               value="12:00">
      </div>

      <div class="form-group">
        <label>ประเภทพื้นที่</label>

        <select id="spaceType">
          <option value="all">
            ทุกประเภท
          </option>

          <option value="Work Desk">
            Work Desk
          </option>

          <option value="Meeting">
            Meeting
          </option>

          <option value="Quiet Zone">
            Quiet Zone
          </option>
        </select>
      </div>

      <button class="btn btn-primary"
              onclick="searchTables()">
        🔎 ค้นหา
      </button>

    </div>

  </div>


  <div class="floor-layout">

    <!-- FLOOR PLAN -->

    <div class="card floor-card">

      <h3>แผนผังพื้นที่</h3>

      <p style="
        color:var(--muted);
        font-size:12px;
        margin-top:3px;
      ">
        คลิกโต๊ะที่มีสถานะ "ว่าง"
        เพื่อเลือก
      </p>

      <div id="floorPlan"
           class="floor-plan"></div>

      <div class="legend">

        <div class="legend-item">
          <span class="legend-color"
                style="background:#86efac"></span>
          ว่าง
        </div>

        <div class="legend-item">
          <span class="legend-color"
                style="background:#fca5a5"></span>
          มีคนจองแล้ว
        </div>

        <div class="legend-item">
          <span class="legend-color"
                style="background:#cbd5e1"></span>
          ปิดปรับปรุง
        </div>

      </div>

    </div>


    <!-- SUMMARY -->

    <div class="card booking-summary">

      <h3>รายละเอียดการจอง</h3>

      <div id="summaryContent"
           class="summary-empty">
        กรุณาค้นหาและเลือกโต๊ะ
      </div>

    </div>

  </div>

